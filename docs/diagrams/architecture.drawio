yle="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="360" height="56" as="geometry"/></mxCell><mxCell id="e4" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;2. express.static(client/dist)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;built React SPA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="222" width="360" height="56" as="geometry"/></mxCell><mxCell id="e6" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;3. /api/ingest/*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ingest router — own x-ingest-token check, before sessions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="294" width="360" height="56" as="geometry"/></mxCell><mxCell id="e8" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;4. /api/navdata (sync)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sidecar rows / demand / state — ingest token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="366" width="360" height="56" as="geometry"/></mxCell><mxCell id="e10" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;5. /mcp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;only if MCP_TOKEN set — own bearer token, outside /api&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="438" width="360" height="56" as="geometry"/></mxCell><mxCell id="e12" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;6. express-session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cookie msfslogger.sid · SQLite-backed store (auth_session)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="360" height="56" as="geometry"/></mxCell><mxCell id="e14" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;7. Ingest-token scope classifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;marks eligible requests; does not gate alone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="582" width="360" height="56" as="geometry"/></mxCell><mxCell id="e16" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;8. requireSameOrigin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CSRF defence-in-depth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="654" width="360" height="56" as="geometry"/></mxCell><mxCell id="e18" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;9. /api/auth/*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;public: login / logout / session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="726" width="360" height="56" as="geometry"/></mxCell><mxCell id="e20" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;10. requireAuth on /api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;valid session OR validly-scoped ingest token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="798" width="360" height="56" as="geometry"/></mxCell><mxCell id="e22" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;11. Feature routers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;flights · trips · settings · planned legs · navdata · exports · acars · sayintentions · ground sessions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="870" width="360" height="56" as="geometry"/></mxCell><mxCell id="e24" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;12. SPA catch-all&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET * → client/dist/index.html&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="942" width="360" height="56" as="geometry"/></mxCell><mxCell id="e26" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;13. Error handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;normalises upload + malformed-JSON errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="1014" width="360" height="56" as="geometry"/></mxCell><mxCell id="e28" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Short-circuits&lt;/b&gt;&lt;br&gt;Steps 3–5 terminate the request in their own router, so agent, sidecar and MCP traffic never allocates a session row.&lt;br&gt;&lt;br&gt;Step 9 is mounted before the gate so the login page can authenticate.&lt;br&gt;&lt;br&gt;Everything registered after step 10 is gated by default — one mount, not per-handler decoration." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bdb76b;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="420" height="170" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Agent / sidecar / MCP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="170" width="200" height="50" as="geometry"/></mxCell><mxCell id="e31" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;dashed=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c30" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;dashed=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c30" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;dashed=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c30" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="flight-state-machine" name="Flight state machine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="src/flightManager.ts — flight state machine (driven by ingest frames)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c2" value="IDLE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="140" height="80" as="geometry"/></mxCell><mxCell id="c3" value="GROUND" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="160" height="80" as="geometry"/></mxCell><mxCell id="c4" value="FLYING" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="160" height="80" as="geometry"/></mxCell><mxCell id="e5" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0;entryY=0.3125;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="165"/></Array></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;5 parked frames&lt;/b&gt; (on ground, GS &amp;lt; 1 kt, engines off or parking brake set)&lt;br&gt;→ resolve nearest airport · non-consuming planned-leg match · open ground_sessions row" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="480" height="50" as="geometry"/></mxCell><mxCell id="e7" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.8125;entryX=0.857;entryY=0;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="205"/></Array></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;slew&lt;/b&gt; or moved &amp;gt; 10 nm from anchor · &lt;b&gt;crash / sim exit&lt;/b&gt;&lt;br&gt;(crash / exit closes only an auto-created session)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="250" y="212" width="430" height="40" as="geometry"/></mxCell><mxCell id="e9" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;3 airborne frames&lt;/b&gt; (not slew, not on ground, IAS &amp;gt; 30 kt)&lt;br&gt;→ insert flights row · close ground session&lt;br&gt;→ auto-link planned leg · file OUT / OFF ACARS" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="795" y="390" width="400" height="60" as="geometry"/></mxCell><mxCell id="e11" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.3125;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="665"/></Array></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;3 airborne frames&lt;/b&gt; (same as above, no ground session)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="190" y="635" width="400" height="25" as="geometry"/></mxCell><mxCell id="e13" value="" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.75;entryX=0.214;entryY=1;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="700"/></Array></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;10 landed frames&lt;/b&gt; (on ground, GS &amp;lt; 5 kt), or immediately on crash / sim disconnect&lt;br&gt;→ final stats · leg &lt;i&gt;flown&lt;/i&gt; (≤ 10 nm from destination) or &lt;i&gt;diverted&lt;/i&gt; · file ON / IN ACARS" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="708" width="540" height="45" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Pause&lt;/b&gt;: the agent forwards SimConnect Pause_EX1 (full, active and menu pause); all stop the flight clock and track recording.&lt;br&gt;&lt;br&gt;&lt;b&gt;Duration&lt;/b&gt;: sum of gaps between recorded points, each ≤ 60 s and not interrupted by pause / slew. Not wall-clock time.&lt;br&gt;&lt;br&gt;&lt;b&gt;Leg match&lt;/b&gt; (legMatcher.ts): exactly one eligible planned leg of the active trip within 10 nm, or a specific reason. It never guesses." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bdb76b;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="440" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
