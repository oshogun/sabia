"20" as="geometry"/></mxCell><mxCell id="c133" value="&lt;table style=&quot;width:100%;font-size:11px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:44px;white-space:nowrap&quot;&gt;&lt;/td&gt;&lt;td&gt;rev&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666&quot;&gt;INTEGER&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c126"><mxGeometry x="0" y="148" width="300" height="20" as="geometry"/></mxCell><mxCell id="e134" value="CASCADE" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=entityRelationEdgeStyle;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;" edge="1" parent="1" source="c17" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e135" value="CASCADE" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=entityRelationEdgeStyle;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;" edge="1" parent="1" source="c28" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e136" value="CASCADE" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=entityRelationEdgeStyle;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;" edge="1" parent="1" source="c35" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e137" value="CASCADE" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=entityRelationEdgeStyle;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;" edge="1" parent="1" source="c47" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e138" value="CASCADE" style="html=1;rounded=1;fontSize=11;labelBackgroundColor=default;edgeStyle=entityRelationEdgeStyle;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=10;startSize=10;" edge="1" parent="1" source="c57" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c139" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Separate SQLite file (NAVDATA_DB_PATH); never part of flights.db. Filled by the MCDU sidecar via /api/navdata/rows; snapshots are swapped by rename(2).&lt;br&gt;• Every row carries &lt;b&gt;rev&lt;/b&gt; for incremental sync.&lt;br&gt;• &lt;b&gt;ref&lt;/b&gt; = logical reference by key, no FK constraint (navaid/waypoint → airport, airway legs → waypoints).&lt;br&gt;• Pending manual fetch requests live in flights.db (navdata_requests) so a replica swap cannot lose them." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bdb76b;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="850" width="740" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
