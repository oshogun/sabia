{
  "name": "msfslogger",
  "version": "1.3.0-beta.1",
  "description": "MSFS 2024 flight logger with web interface",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:server": "ts-node src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "backfill-icao": "ts-node src/backfill-icao.ts",
    "build-airport-tiers": "ts-node src/buildAirportTiers.ts",
    "backfill-durations": "ts-node src/backfill-durations.ts",
    "backup": "node dist/backup.js",
    "set-password": "node dist/setPassword.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json",
    "test:client": "cd client && npm test",
    "test:e2e": "cd client && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "express": "^4.18.3",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "puppeteer@25.11.0": true
  }
}
